<?xml version="1.0"?>
<ruleset name="Hybrid Cookies conset R+">

	<description>Coding standards pre plugin Hybrid Cookies conset R+.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/admin/ui/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="8.1-"/>

	<!--
		WordPress Coding Standards.
		Filtrácia názvov súborov je vypnutá, pretože používame PSR-4
		autoloading: názov súboru musí byť zhodný s názvom triedy
		(napr. `Consent_Module.php` pre `HCC\Modules\Consent\Consent_Module`).
	-->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Prefix všetkých globalnych symbolov -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="hcc"/>
				<element value="HCC"/>
			</property>
		</properties>
		<!--
			`hcc` má 3 znaky, WPCS by odporúčalo aspoň 4. Prefix je daný
			názvom pluginu a zhoduje sa s REST namespace `hcc/v1` a
			prefixom tabuliek `{prefix}hcc_*`, takže ho ponechávame.
		-->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>

	<!-- Text domain je povinny -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="hybrid-cookies-conset-r-plus"/>
			</property>
		</properties>
	</rule>

	<!-- PHP 8.1 kompatibilita (kontraktuje s testVersion vyššie) -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- striktné typy vyžadujeme všade -->
	<config name="php_version" value="80100"/>

	<!-- Zákaz tichých chýb (@) -->
	<rule ref="Generic.PHP.NoSilencedErrors.Discouraged"/>

	<!--
		Repozitáry zostavujú SQL z názvov tabuliek, ktoré vracia
		`HCC\Tables::get()` — to je whitelist konštánt, nie používateľský
		vstup. `$wpdb->prepare()` tu nemá čo upravovať, pretože placeholder
		pre názov tabuľky neexistuje a všetky hodnoty idú cez `prepare()`
		na samostatnom mieste.

		Toto je zámerné vypnutie, nie obídenie — ak sa v kóde objaví
		interpolovaná hodnota od používateľa, PHPCS to už nezachytí.
		Preto `Tables::get()` nikdy neprijíma vstup zvonka.
	-->
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<exclude-pattern>*/modules/*Repository.php</exclude-pattern>
	</rule>

	<!--
		Read-only dotazy nad tabuľkami pluginu sú cacheované cez transient
		alebo bežia iba v admin kontexte, kde je načítanie z DB očakávané.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/modules/*Repository.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.DB.PreparedSQL">
		<exclude-pattern>*/modules/*Repository.php</exclude-pattern>
		<exclude-pattern>*/modules/*Recorder.php</exclude-pattern>
	</rule>

	<!-- Recorder robí len `DELETE` pri čistení logov — je to jediný dotaz. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/modules/*Recorder.php</exclude-pattern>
	</rule>

	<!-- Testy používajú vlastné stuby WordPress funkcií. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- PHPUnit testy nepotrebujú `declare(strict_types)` kontrolu. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

</ruleset>