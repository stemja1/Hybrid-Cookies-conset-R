{
  "name": "stemja1/hybrid-cookies-conset-r-plus",
  "description": "Consent banner, katalog cookies a blokovanie trackovacich skriptov pre WordPress (GDPR/CCPA).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": ["wordpress", "wordpress-plugin", "cookie", "cookie-consent", "gdpr", "banner", "consent"],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "autoload": {
    "psr-4": {
      "HCC\\": "includes/",
      "HCC\\Modules\\": "modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HCC\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit"
  }
}
